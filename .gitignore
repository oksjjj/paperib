# --- OS / editor ---
.DS_Store
.idea/
*.swp

# --- Secrets ---
.env
.env.*
!.env.example

# --- Python ---
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# --- Model weights / serialized arrays (anywhere) ---
*.pt
*.pth
*.ckpt
*.pkl
events.out.tfevents.*
*.log

# --- Data: track only README / labels / predictions ---
/data/*
!/data/.gitkeep
!/data/README.md
!/data/ib_data/

/data/ib_data/*
!/data/ib_data/.gitkeep
!/data/ib_data/README.md
!/data/ib_data/labels/
!/data/ib_data/predictions/

/data/ib_data/labels/*
!/data/ib_data/labels/.gitkeep
!/data/ib_data/labels/*_labels.json

/data/ib_data/predictions/*
!/data/ib_data/predictions/.gitkeep
!/data/ib_data/predictions/*.json

# Never commit PLMN/metric de-identification maps (or paste mappings into docs).

# --- Upstream clones ---
/Argos/

# --- Experiment artifacts (keep source) ---
/OmniAnomaly/model/
/OmniAnomaly/result/
/OmniAnomaly/log/*
!/OmniAnomaly/log/.gitkeep

# AnomalyTransformer/model/ also holds source (attn.py, …); ignore run subdirs only.
/AnomalyTransformer/model/*/
/AnomalyTransformer/result/

/LSTM_AD/model/

# --- Local outputs / caches ---
graph/
analysis/
results/
cache/
